# Copy to .env and fill in real values. Never commit .env.

# Supabase (browser-safe anon key only — never service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin dashboard unlock phrase (embedded in client JS — use a long random string)
VITE_ADMIN_SECRET=change-me-to-a-long-random-phrase

# Optional analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional — only for Node image-sync tooling (npm run images:sync)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
